{% render 'recommendations' %}

<style>
  .product-recommendations {
    margin-top: 40px;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 4rem 0;
  }

  .product-recommendations h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 20px;
    text-align: center;
  }

  /* Make slider horizontally scrollable */
  .recommendation-slider {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding: 0 16px;
  }

  .recommendations-grid {
    display: grid;
    grid-auto-flow: column;
    justify-content: center;
    grid-auto-columns: calc(25% - 15px); /* 4 per row */
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  @media screen and (max-width: 480px) {
    .recommendations-grid {
      grid-auto-columns: calc(50% - 15px);
    }
  }

  .recommendations-grid li {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    text-align: center;
    scroll-snap-align: start;
  }

  .recommendations-grid li:hover {
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
  }

  .recommendations-grid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  .recommendations-grid span {
    display: block;
    padding: 8px 12px;
    font-size: 0.9rem;
    color: #333;
  }

  .recommendations-grid span:last-child {
    font-weight: 600;
    color: #111;
  }

  /* Hide scrollbar (optional) */
  .recommendation-slider::-webkit-scrollbar {
    display: none;
  }
  .recommendation-slider {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>


<script>
document.addEventListener("DOMContentLoaded", () => {
  const section = document.querySelector(".product-recommendations");
  if (!section) return;

  const handleIntersection = (entries, observer) => {
    if (!entries[0].isIntersecting) return;

    observer.unobserve(section);

    const url = section.dataset.url;
    fetch(url)
      .then((response) => response.text())
      .then((html) => {
        const tempDiv = document.createElement("div");
        tempDiv.innerHTML = html;

        const recommendations = tempDiv.querySelector(".product-recommendations");
        if (recommendations && recommendations.innerHTML.trim().length) {
          section.innerHTML = recommendations.innerHTML;
        }
      })
      .catch((err) => {
        console.error("Error loading product recommendations:", err);
      });
  };

  const observer = new IntersectionObserver(handleIntersection, {
    rootMargin: "0px 0px 200px 0px",
  });

  observer.observe(section);
});
</script>

{% schema %}
    {
        "name": "t:sections.product-recommendation.name",
        "settings": [],
        "presets": [
            {
                "name": "t:sections.product-recommendation.presets.name"
            }
        ]
    }
{% endschema %}