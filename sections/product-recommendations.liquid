{% render 'recommendations' %}

<style>
  .product-recommendations {
    margin-top: 40px;
    max-width: 1200px;
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding: 2rem 1rem;
  }

  .product-recommendations h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .recommendation-slider {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .recommendations-grid {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recommendations-grid li {
    flex: 0 0 200px;
    background: #fff;
    border: 1px solid #eee;
    border-radius: 12px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    text-align: center;
    transition: transform 0.2s ease;
  }

  .recommendations-grid li:hover {
    transform: translateY(-4px);
  }

  .recommendations-grid img {
    width: 100%;
    height: 150px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    object-fit: cover;
  }

  .recommendations-grid span {
    display: block;
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
    color: #333;
  }

  .recommendations-grid span:last-child {
    font-weight: 600;
    color: #111;
  }

  .recommendation-slider::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const section = document.querySelector(".product-recommendations");
  if (!section) return;

  const handleIntersection = (entries, observer) => {
    if (!entries[0].isIntersecting) return;

    observer.unobserve(section);

    const url = section.dataset.url;
    fetch(url)
      .then((response) => response.text())
      .then((html) => {
        const tempDiv = document.createElement("div");
        tempDiv.innerHTML = html;

        const recommendations = tempDiv.querySelector(".product-recommendations");
        if (recommendations && recommendations.innerHTML.trim().length) {
          section.innerHTML = recommendations.innerHTML;
        }
      })
      .catch((err) => {
        console.error("Error loading product recommendations:", err);
      });
  };

  const observer = new IntersectionObserver(handleIntersection, {
    rootMargin: "0px 0px 200px 0px",
  });

  observer.observe(section);
});
</script>

{% schema %}
    {
        "name": "t:sections.product-recommendation.name",
        "settings": [
          {
            "type": "text",
            "label": "Section Heading",
            "id": "section_heading"
          }
        ],
        "presets": [
            {
                "name": "t:sections.product-recommendation.presets.name"
            }
        ]
    }
{% endschema %}