<section class="newsletter-signup">
  <div class="newsletter-container">
    <h2>Subscribe to Our Newsletter</h2>
    <p>Be the first to know about new arrivals, exclusive deals, and more.</p>

    {% form 'customer', class: 'newsletterForm', id: 'newsletter-form' %}      
      <input
        type="email"
        name="contact[email]"
        placeholder="Enter your email"
        required
      >
      <button type="submit" class="subscribe-btn">Subscribe</button>

      {% if form.posted_successfully? %}
        <P class="success-message">Thank you for subscribing!</P>
      {% elsif form.errors %}
        <P class="error-message">{{ form.errors | default_errors }}</P>
      {% endif %}
    {% endform %}
  </div>
</section>

{% style %}
  .newsletter-signup {
    padding: 4rem 10rem;
    text-align: center;
    background-color: #f9f9f9;
  }

  .newsletter-container h2 {
    font-size: 2.5rem;
    margin-bottom: 10px;
  }

  .newsletter-container p {
    font-size: 1.6rem;
    margin-bottom: 20px;
  }

  .newsletterForm {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
  }

  .newsletterForm input {
    border: 1px solid black;
    max-width: 400px;
    width: 100%;
    padding: 12px 20px;
    font-size: 1rem;
  }

  .newsletterForm input:focus {
    outline: none;
    border-color: #555;
  }

  .newsletterForm .subscribe-btn {
    padding: 12px 20px;
    max-width: 400px;
    width: 100%;
    background-color: black;
    border: none;
    color: white;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .newsletterForm .subscribe-btn:hover {
    background-color: #333;
  }

  @media (max-width: 1024px) {
    .newsletter-signup {
      padding: 3rem 5rem;
    }

    .newsletter-container h2 {
      font-size: 2.2rem;
    }

    .newsletter-container p {
      font-size: 1.4rem;
    }
  }

  @media (max-width: 768px) {
    .newsletter-signup {
      padding: 2rem;
    }

    .newsletter-container h2 {
      font-size: 2rem;
    }

    .newsletter-container p {
      font-size: 1.3rem;
    }

    .newsletterForm input,
    .newsletterForm .subscribe-btn {
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .newsletter-signup {
      padding: 1.5rem 1rem;
    }

    .newsletter-container h2 {
      font-size: 1.8rem;
    }

    .newsletter-container p {
      font-size: 1.1rem;
    }

    .newsletterForm input,
    .newsletterForm .subscribe-btn {
      max-width: 100%;
      font-size: 0.9rem;
    }
  }
{% endstyle %}


{% schema %}
{
  "name": "t:sections.Newsletter.name",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.Newsletter.presets.name"
    }
  ]
}
{% endschema %}
