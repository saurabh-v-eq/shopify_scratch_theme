<section class="header-container {% if section.settings.logo_position == 'center' %}logo-center{% else %}logo-left{% endif %}">
  <div class="logo">
    {% if settings.logo %}
      <a href="{{ routes.root_url }}">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url }}" height="auto" width="{{ settings.logo_width }}">
        {% endif %}
      </a>
    {% endif %}
  </div>
  <div class="nav-toggle" id="nav-toggle">&#9776;</div>
  <div class="nav-links-wrapper">
    <ul class="nav-links">
      {% for link in linklists['main-menu'].links %}
        <a href="{{ link.url }}" class="nav-link">
          {% if link.title != blank %}
            <li class="link-item">{{ link.title | escape }}</li>
          {% endif %}
        </a>
      {% endfor %}
    </ul>
  </div>
  <div class="icons">
    <div class="user-icon">
      <a href="{{ routes.account_url }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
          <path d="M224 256A128 128 0 1 0 224 0a128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3C0 498.7 13.3 512 29.7 512l388.6 0c16.4 0 29.7-13.3 29.7-29.7C448 383.8 368.2 304 269.7 304l-91.4 0z"/>
        </svg>
      </a>
    </div>
    <div class="cart-icon">
      {% if settings.cart_type == 'drawer' %}
        <a id="cart-icon-button">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
            <path d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"/>
          </svg>
        </a>
      {% else %}
        <a href="{{ routes.cart_url }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
            <path d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 4rem;
    border-bottom: 1px solid gray;
    position: relative;
    background-color: white;
  }

  .logo-left {
    justify-content: space-between;
  }

  .logo-center {
    justify-content: center;
  }

  .logo-center .nav-links-wrapper,
  .logo-center .icons {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .logo-center .nav-links-wrapper {
    left: 2rem;
  }

  .logo-center .icons {
    right: 2rem;
  }

  /* Logo image */
  .logo img {
    max-height: 50px;
    width: auto;
  }

  /* Navigation links */
  .nav-links-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 20px;
    padding: 0;
    margin: 0;
  }

  .link-item {
    display: flex;
    align-items: center;
  }

  .nav-link {
    text-decoration: none;
    color: black;
    font-weight: 500;
    padding: 8px 12px;
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: #555;
  }

  /* Icons */
  .icons {
    display: flex;
    gap: 15px;
  }

  .user-icon,
  .cart-icon {
    cursor: pointer;
  }

  .header-container svg {
    height: 20px;
    width: 20px;
    fill: currentColor;
  }

  /* Nav toggle for mobile */
  .nav-toggle {
    display: none;
    font-size: 28px;
    cursor: pointer;
    position: absolute;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
  }

  /* Responsive adjustments */
  @media (max-width: 1024px) {
    .header-container {
      padding: 1.5rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 1rem 1.5rem;
    }

    .nav-links-wrapper {
      display: none;
    }

    .nav-toggle {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 1rem;
    }
  }
{% endstyle %}


{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Middle Left"
        },
        {
          "value": "center",
          "label": "Middle Center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
