<section class="header-container {% if section.settings.logo_position == 'center' %}logo-center{% else %}logo-left{% endif %}">
  <div class="logo">
    {% if settings.logo %}
      <a href="{{ routes.root_url }}">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url }}" height="auto" width="{{ settings.logo_width }}">
        {% endif %}
      </a>
    {% endif %}
  </div>
  <div class="nav-toggle" id="nav-toggle">&#9776;</div>
  <div class="nav-links-wrapper">
    <ul class="nav-links">
      {% for link in linklists['main-menu'].links %}
        <a href="{{ link.url }}" class="nav-link">
          {% if link.title != blank %}
            <li class="link-item">{{ link.title | escape }}</li>
          {% endif %} 
        </a>
      {% endfor %}
    </ul>
  </div>
  <div class="icons">
    <div class="search-bar">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
        <input 
          type="search" 
          name="q" 
          id="SearchInput" 
          placeholder="Search products..." 
          autocomplete="off"
          aria-label="Search"
        >
        <button type="submit" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
            <path d="M505 442.7l-99.7-99.7C429.5 304.3 448 263.1 448 216 448 
              97 351 0 232 0S16 97 16 216s97 216 216 216c47.1 0 88.3-18.5 
              127-42.7l99.7 99.7c9.4 9.4 24.6 9.4 33.9 
              0l12.4-12.4c9.5-9.4 9.5-24.6.1-34zM232 
              368c-83.8 0-152-68.2-152-152S148.2 
              64 232 64s152 68.2 152 152-68.2 152-152 152z"/>
          </svg>
        </button>
      </form>
      <div id="predictive-search-results" class="predictive-results"></div>
    </div>
    <div class="user-icon">
      <a href="{{ routes.account_url }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512">
          <path d="M224 256A128 128 0 1 0 224 0a128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3C0 498.7 13.3 512 29.7 512l388.6 0c16.4 0 29.7-13.3 29.7-29.7C448 383.8 368.2 304 269.7 304l-91.4 0z"/>
        </svg>
      </a>
    </div>
    <div class="cart-icon">
      {% if settings.cart_type == 'drawer' %}
        <a id="cart-icon-button">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
            <path d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"/>
          </svg>
        </a>
      {% else %}
        <a href="{{ routes.cart_url }}">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512">
            <path d="M0 24C0 10.7 10.7 0 24 0L69.5 0c22 0 41.5 12.8 50.6 32l411 0c26.3 0 45.5 25 38.6 50.4l-41 152.3c-8.5 31.4-37 53.3-69.5 53.3l-288.5 0 5.4 28.5c2.2 11.3 12.1 19.5 23.6 19.5L488 336c13.3 0 24 10.7 24 24s-10.7 24-24 24l-288.3 0c-34.6 0-64.3-24.6-70.7-58.5L77.4 54.5c-.7-3.8-4-6.5-7.9-6.5L24 48C10.7 48 0 37.3 0 24zM128 464a48 48 0 1 1 96 0 48 48 0 1 1 -96 0zm336-48a48 48 0 1 1 0 96 48 48 0 1 1 0-96z"/>
          </svg>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 4rem;
    position: relative;
    background-color: white;
    z-index: 1000;
    box-shadow: 10px 0px 10px black;
  }

  .logo-left {
    justify-content: space-between;
  }

  .logo-center {
    justify-content: center;
  }

  .logo-center .nav-links-wrapper,
  .logo-center .icons {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
  }

  .logo-center .nav-links-wrapper {
    left: 2rem;
  }

  .logo-center .icons {
    right: 2rem;
  }

  .logo img {
    max-height: 50px;
    width: auto;
  }

  .nav-links-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 20px;
    padding: 0;
    margin: 0;
  }

  .link-item {
    display: flex;
    align-items: center;
  }

  .nav-link {
    text-decoration: none;
    color: black;
    font-weight: 500;
    padding: 8px 12px;
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: #555;
  }

  .icons {
    display: flex;
    gap: 15px;
    align-items: center;
  }

  .user-icon,
  .cart-icon {
    cursor: pointer;
  }

  .header-container svg {
    height: 20px;
    width: 20px;
  }

  .nav-toggle {
    display: none;
    font-size: 28px;
    cursor: pointer;
    position: absolute;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 1024px) {
    .header-container {
      padding: 1.5rem 2rem;
    }
  }

  @media (max-width: 768px) {
    .header-container {
      padding: 1rem 1.5rem;
    }

    .nav-links-wrapper {
      display: none;
    }

    .nav-toggle {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 1rem;
    }
  }

  .search-bar {
    position: relative;
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0px;
  }

  .search-form input {
    padding: 8px 28px 8px 12px;
    border: 1px solid #ddd;
    border-radius: 6px;
    outline: none;
    width: 300px;
    position: relative;
  }

  .search-form button {
    background: none;
    border: none;
    cursor: pointer;
    position: absolute;
    right: 0;
  }

  .predictive-results {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    max-height: 300px;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 10px;
    display: none;
    z-index: 50;
    box-sizing: border-box;
  }

  .predictive-results h4 {
    margin: 5px 0;
    font-size: 12px;
    font-weight: 600;
  }

  .predictive-results ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .predictive-results li {
    padding: 6px 0;
  }

  .predictive-results a {
    text-decoration: none;
    color: black;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .predictive-results a:hover {
    color: #0073e6;
  }

{% endstyle %}

<script>
document.addEventListener("DOMContentLoaded", function () {
  const searchInput = document.getElementById("SearchInput");
  const resultsContainer = document.getElementById("predictive-search-results");

  let debounceTimer;

  searchInput.addEventListener("input", function () {
    const query = this.value.trim();
    clearTimeout(debounceTimer);

    if (query.length < 2) {
      resultsContainer.innerHTML = "";
      resultsContainer.style.display = "none";
      return;
    }

    debounceTimer = setTimeout(() => {
      fetch(`/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product,collection,article,page`)
        .then(response => response.json())
        .then(data => {
          // Clear old results
          resultsContainer.innerHTML = "";

          // PRODUCTS
          if (data.resources.results.products.length > 0) {
            const productsTitle = document.createElement("h4");
            productsTitle.textContent = "Products";
            resultsContainer.appendChild(productsTitle);

            const ul = document.createElement("ul");

            data.resources.results.products.forEach(product => {
              const li = document.createElement("li");

              li.innerHTML = `
                <a href="${product.url}">
                  <img src="${product.image}" alt="${product.title}" width="40" height="40">
                  <h4>${product.title}</h4>
                  <p>${product.price}</p>
                </a>
              `;

              ul.appendChild(li);
            });

            resultsContainer.appendChild(ul);
          }

          // COLLECTIONS
          if (data.resources.results.collections.length > 0) {
            const collectionsTitle = document.createElement("h4");
            collectionsTitle.textContent = "Collections";
            resultsContainer.appendChild(collectionsTitle);

            const ul = document.createElement("ul");

            data.resources.results.collections.forEach(collection => {
              const li = document.createElement("li");
              li.innerHTML = `<a href="${collection.url}">${collection.title}</a>`;
              ul.appendChild(li);
            });

            resultsContainer.appendChild(ul);
          }

          resultsContainer.style.display = "block";
        })
        .catch(err => {
          console.error("Predictive search error:", err);
        });
    }, 300); // debounce 300ms
  });
});
</script>


{% schema %}
{
  "name": "t:sections.header.name",
  "settings": [
    {
      "type": "select",
      "id": "logo_position",
      "label": "Logo Position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Middle Left"
        },
        {
          "value": "center",
          "label": "Middle Center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.header.presets.name"
    }
  ]
}
{% endschema %}
