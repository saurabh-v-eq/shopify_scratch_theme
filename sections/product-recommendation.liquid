<div
  class="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related"
>
  {% if recommendations.performed? and recommendations.products_count > 0 %}
    {% if recommendations.intent == 'related' %}
      <h2>You may also like</h2>
    {% elsif recommendations.intent == 'complementary' %}
      <h2>Pair it with</h2>
    {% endif %}
    <div class="recommendation-slider">
      <ul class="recommendations-grid">
        {% for product in recommendations.products %}                
          <li>
            <a href="{{ product.url }}">
              <img
                src="{{ product.featured_image | image_url }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
                height=""
                width=""
              >
              <span>{{ product.title }}</span>
              <span>{{ product.price | money }}</span>
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
</div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const section = document.querySelector(".product-recommendations");
  if (!section) return;

  const handleIntersection = (entries, observer) => {
    if (!entries[0].isIntersecting) return;

    observer.unobserve(section);

    const url = section.dataset.url;
    fetch(url)
      .then((response) => response.text())
      .then((html) => {
        const tempDiv = document.createElement("div");
        tempDiv.innerHTML = html;

        const recommendations = tempDiv.querySelector(".product-recommendations");
        if (recommendations && recommendations.innerHTML.trim().length) {
          section.innerHTML = recommendations.innerHTML;
        }
      })
      .catch((err) => {
        console.error("Error loading product recommendations:", err);
      });
  };

  const observer = new IntersectionObserver(handleIntersection, {
    rootMargin: "0px 0px 200px 0px",
  });

  observer.observe(section);
});
</script>


<style>
    /* Product Recommendations Section */
    .product-recommendations {
    margin-top: 40px;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    }

    .product-recommendations h2 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 20px;
    text-align: center;
    }

    .recommendations-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(180px, 1fr));
    gap: 20px;
    list-style: none;
    padding: 0;
    margin: 0;
    }

    .recommendations-grid li {
    background: #fff;
    border: 1px solid #e5e5e5;
    border-radius: 10px;
    overflow: hidden;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
    text-align: center;
    }

    .recommendations-grid li:hover {
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    transform: translateY(-3px);
    }

    .recommendations-grid img {
    width: 100%;
    height: auto;
    display: block;
    }

    .recommendations-grid span {
    display: block;
    padding: 8px 12px;
    font-size: 0.9rem;
    color: #333;
    }

    .recommendations-grid span:last-child {
    font-weight: 600;
    color: #111;
    }
</style>

{% schema %}
    {
        "name": "t:sections.product-recommendation.name",
        "settings": [],
        "presets": [
            {
                "name": "t:sections.product-recommendation.presets.name"
            }
        ]
    }
{% endschema %}