{% assign product = all_products[section.settings.product] %}
<div class="product-card">
  {% assign image_media = product.media | where: 'media_type', 'image' %}

  {% if image_media.size > 1 %}
    <div class="main-img-container">
      <img src="{{ image_media.first | image_url }}" alt="Main Image" class="main-image" height="" width="">
    </div>

    <div class="swiper">
      <div class="swiper-wrapper">
        {% for media in image_media %}
          <div class="swiper-slide">
            <img src="{{ media | image_url }}" alt="Thumbnail" height="" width="">
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="main-img-container">
    <img src="{{ image_media.first  | image_url }}" alt="Main Image" class="main-image" height="" width="">
    </div>
  {% endif %}
</div>

{% schema %}
    {
        "name": "Swiper Slider",
        "settings": [
          {
            "type": "product",
            "label": "Select Product",
            "id": "product"
          }
        ],
        "presets": [
            {
                "name": "Swiper Slider"
            }
        ]
    }
{% endschema %}