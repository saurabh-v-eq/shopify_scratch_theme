{{ 'footer.css' | asset_url | stylesheet_tag }}
<footer class="footer">
  <div class="footer-container">
    {%- assign footer_menus = linklists['footer'] -%} 
    {% if footer_menus.links.size > 0 %}  
      {% for link in footer_menus.links %}        
        <div class="footer-column">
          <h4>{{ link.title }}</h4>
          {% if link.links.size > 0 %}            
            <ul>
              {% for sublink in link.links %}
                <li><a href="{{ sublink.url }}">{{ sublink.title }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endfor %}    
    {% endif %}

    <div class="footer-column">
      {% if section.settings.heading != blank %}
        <h4>{{ section.settings.heading }}</h4>
      {% endif %}
      {% if section.settings.subheading != blank %}
        <p>{{ section.settings.subheading }}</p>
      {% endif %}
      {% form 'customer', class: 'newsletter-form' %}        
        <input type="email" name="contact[email]" placeholder="Enter your email" id="newsletter-input">
        {% if section.settings.btn_heading != blank %}          
          <button type="submit">{{ section.settings.btn_heading }}</button>
        {% endif %}

        {% if form.posted_successfully? %}
          <P class="success-message">Thank you for subscribing!</P>
        {% elsif form.errors %}
          <P class="error-message">{{ form.errors | default_errors }}</P>
        {% endif %}
      {% endform %}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "text",
      "label": "Newsletter Heading",
      "id": "heading",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "label": "Newsletter Subheading",
      "id": "subheading",
      "default": "Subscribe to get updates & offers."
    },
    {
      "type": "text",
      "label": "Button Heading",
      "id": "btn_heading",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "t:sections.footer.presets.name"
    }
  ]
}
{% endschema %}
