<script src="{{ 'facetFilter.js' | asset_url }}" defer></script>

<h2 class="collection-title">Collection Products</h2>

{% paginate collection.products by 4 %}
  <div class="collection-wrapper">
    <!-- Sidebar Filters -->
    <aside class="facet-filters" aria-label="Collection Filters">
      <h2 class="facet-filter-title">
        {% render 'icons', icon: 'filter-icon' %}
        Filters
      </h2>

      <form id="FacetFiltersForm" class="facets-form" aria-live="polite">
        <div class="collection-filter__active-values">
          {% for filter in collection.filters %}
            {% for value in filter.active_values %}
              <div class="collection-filters__active-filter-swatch">
                <a href="{{ value.url_to_remove }}" class="active-filter-tag">
                  <span class="active-filter-label">{{ value.label }}</span>
                  <span class="active-filter-remove" aria-hidden="true">&times;</span>
                </a>
              </div>
            {% endfor %}
          {% endfor %}
        </div>

        {% for filter in collection.filters %}
          <details class="facet">
            <summary class="facet-title" role="button" aria-expanded="false" tabindex="0">{{ filter.label }}</summary>

            <div class="facet-options {% if filter.param_name == 'filter.v.option.color' %} color-swatches {% endif %}">
              {% if filter.type == 'price_range' %}
                <div class="price-range">
                  <label for="{{ filter.min_value.param_name }}">
                    Min Price
                    <input
                      id="{{ filter.min_value.param_name }}"
                      name="{{ filter.min_value.param_name }}"
                      type="number"
                      placeholder="0"
                      value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                      min="0"
                      aria-label="Minimum price filter"
                    >
                  </label>

                  <label for="{{ filter.max_value.param_name }}">
                    Max Price
                    <input
                      id="{{ filter.max_value.param_name }}"
                      name="{{ filter.max_value.param_name }}"
                      type="number"
                      placeholder="100000"
                      value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                      min="0"
                      aria-label="Maximum price filter"
                    >
                  </label>
                </div>
              {% else %}
                {% for value in filter.values %}
                  {% if filter.param_name == 'filter.v.option.color' %}
                    <label class="color-swatch-label">
                      <input
                        type="checkbox"
                        name="{{ filter.param_name }}"
                        value="{{ value.value }}"
                        {% if value.active %}
                          checked
                        {% endif %}
                        {% if value.count == 0 and value.active == false %}
                          disabled
                        {% endif %}
                        aria-checked="{{ value.active }}"
                      >
                      <span 
                        class="color-swatch"
                        style="background-color: {{ value.value | downcase }};"
                        title="{{ value.label }}"
                      >
                      </span>
                    </label>
                  {% else %}
                    <label>
                      <input
                        type="checkbox"
                        name="{{ filter.param_name }}"
                        value="{{ value.value }}"
                        {% if value.active %}
                          checked
                        {% endif %}
                        {% if value.count == 0 and value.active == false %}
                          disabled
                        {% endif %}
                        aria-checked="{{ value.active }}"
                      >
                      {{ value.label }} (<span aria-live="polite">{{ value.count }}</span>)
                    </label>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          </details>
        {% endfor %}

        {% comment %}
          <noscript>
            <button type="submit" class="btn">Apply filters</button>
          </noscript>
        {% endcomment %}
      </form>
    </aside>

    <!-- Product Grid -->
    <section class="product-grid" id="product-grid" aria-label="Collection Products">
      <div id="product-list">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>

      {% if paginate.next %}
        <div class="load-more-wrapper">
          <button
            class="btn load-more-btn"
            id="load-more"
            data-next-url="{{ paginate.next.url }}"
            aria-label="Load more products"
          >
            Load More
          </button>
        </div>
      {% endif %}
    </section>
  </div>
{% endpaginate %}

{% style %}


/* Layout */
.collection-title {
  text-align: center;
    padding: 1.5rem 2rem;
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.8rem);
  }
  
  .collection-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 2rem;
    padding: 2rem 3rem;
    flex-wrap: wrap;
  }
  
  .facet-filters {
    width: 250px;
    flex-shrink: 0;
  }
  
  .facet-filter-title {
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 1rem;
  }
  
  .facets-form .facet {
    border-bottom: 1px solid #e5e5e5;
    padding: 12px 0;
  }
  
  .facets-form .facet:first-child {
    border-top: 1px solid #e5e5e5;
  }
  
  summary.facet-title {
    cursor: pointer;
    font-weight: 500;
    outline-offset: 2px;
  }
  
  .facet-options {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-left: 12px;
  }
  
  .price-range label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.9rem;
  }
  
  .price-range input[type='number'] {
    width: 100%;
    padding: 6px 8px;
    font-size: 0.95rem;
    border: 1px solid #ddd;
    border-radius: 4px;
  }
  
  /* Product Grid */
  #product-list {
    flex-grow: 1;
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 20px;
    margin-bottom: 30px;
    width: 100%;
  }
  
  /* Load More Button */
  .load-more-wrapper {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }
  
  .btn {
    height: 40px;
    min-width: 120px;
    background-color: #000;
    color: #fff;
    border: none;
    font-size: 15px;
    cursor: pointer;
    border-radius: 4px;
    transition: background-color 0.3s ease;
    padding: 0 1rem;
  }
  
  .btn:hover,
  .btn:focus {
    background-color: #444;
    outline: none;
  }
  
  /* Product Card */
  .product-card {
    border-radius: 6px;
    background-color: #fff;
    box-shadow: rgba(99, 99, 99, 0.15) 0px 2px 8px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease;
  }
  
  .product-card:hover {
    transform: translateY(-2px);
  }
  
  .product-img img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    margin-bottom: 10px;
    border-radius: 4px;
  }
  
  /* Color Swatches */
  .color-swatch-label {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
  }
  
  .color-swatch-label input {
    display: none;
  }
  
  .color-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28px, 1fr));
    gap: 6px;
  }
  
  .color-swatch {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid #ddd;
    display: inline-block;
    transition: all 0.2s ease;
  }
  
  .color-swatch-label input:checked + .color-swatch {
    border: 2px solid #000;
  }
  
  .color-swatch-label input:disabled + .color-swatch {
    opacity: 0.3;
    cursor: not-allowed;
  }
  
  /* Responsive Styles */
  @media (max-width: 1024px) {,
    .collection-wrapper {
      gap: 1.5rem;
      padding: 1.5rem 2rem;
    }
    
    .facet-filters {
      width: 200px;
    }

    #product-list {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }
  }
  
  @media (max-width: 768px) {
    .collection-wrapper {
      flex-direction: column;
      padding: 1.5rem;
    }

    .facet-filters {
      width: 100%;
      order: -1;
      margin-bottom: 1rem;
    }
    
    .facet-filter-title {
      justify-content: space-between;
    }
    
    #product-list {
      grid-template-columns: repeat(2, minmax(160px, 1fr));
      gap: 16px;
    }
  }
  
  @media (max-width: 480px) {
    .collection-title {
      padding: 1rem;
      font-size: 1.2rem;
    }
    
    .product-card {
      padding: 12px;
    }
    
    .product-img img {
      height: 180px;
    }
    
    #product-list {
      grid-template-columns: 1fr;
      gap: 14px;
    }
    
    .btn {
      width: 100%;
      max-width: none;
      font-size: 14px;
      height: 38px;
    }
    
    .color-swatch {
      width: 24px;
      height: 24px;
    }
  }
  
  .collection-wrapper {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 2rem;
    padding: 2rem 3rem;
  }
  
  @media (max-width: 768px) {
    .collection-wrapper {
      grid-template-columns: 1fr;
      padding: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    #product-list {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
  
  .collection-filter__active-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  
  .collection-filters__active-filter-swatch {
    display: inline-block;
  }
  
  .active-filter-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: #2563eb;
    color: #fff;
    font-size: 0.875rem;
    padding: 0.4rem 0.75rem;
    border-radius: 9999px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  
  .active-filter-tag:hover {
    background-color: #1e40af;
    transform: translateY(-1px);
  }
  
  .active-filter-remove {
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.home-collection.name",
  "presets": [
    {
      "name": "t:sections.home-collection.presets.name"
    }
  ]
}
{% endschema %}
