<script src="{{ 'load-more-product.js' | asset_url }}" defer></script>
<h2 class="collection-title">Collection Products</h2>
<section class="product-grid" id="product-grid">
  {% paginate collections.frontpage.products by 4 %}
    {% for product in collections.frontpage.products %}
      {% render 'product-card', product: product %}
    {% endfor %}
  {% endpaginate %}
</section>

{% paginate collections.frontpage.products by 4 %}
  {% if paginate.next %}
    <div class="load-more-wrapper">
      <button class="btn" id="load-more" data-next-url="{{ paginate.next.url }}">Load More</button>
    </div>
  {% endif %}
{% endpaginate %}

{% style %}
  .collection-title {
    text-align: center;
    padding: 1.5rem 5rem;
  }

  .product-grid {
    display: grid;
    flex-direction: column;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 0 10rem;
    margin-bottom: 30px;
  }

  .product-card {
    border-radius: 5px;
    background-color: white;
    box-shadow: rgba(99, 99, 99, 0.2) 0px 2px 8px 0px;
    padding: 20px;
  }

  .product-img img {
    width: 100%;
    height: auto;
    display: block;
    transition: 0.3s ease-in-out;
    margin-bottom: 10px;
  }

  .product-img img:hover {
    transform: scale(1.03);
  }

  .load-more-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .btn {
    height: 40px;
    width: 100px;
    background-color: black;
    color: white;
    border: none;
    font-size: 15px;
    cursor: pointer;
  }

  .cartButton {
    position: relative;
    max-width: 200px;
    width: 100%;
    padding: 10px 15px;
    background-color: black;
    color: white;
    font-size: 15px;
    border: none;
    cursor: pointer;
  }

  .cartButton::after {
    content: '';
    position: absolute;
    top: 4px;
    left: 4px;
    width: calc(100% - 2px);
    height: calc(100% - 2px);
    border: 1px solid black;
    z-index: 1;
    transition: all 0.3s ease;
  }

  .cartButton:hover::after {
    top: 0;
    left: 0;
  }
  @media screen and (max-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .product-grid {
      padding: 0 6rem;
    }
  }

  @media screen and (max-width: 480px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .product-card h4 {
      font-size: 14px;
    }
    .product-card p {
      font-size: 13px;
    }

    .product-grid {
      padding: 0 4rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.home-collection.name",
  "presets": [
    {
      "name": "t:sections.home-collection.presets.name"
    }
  ]
}
{% endschema %}
