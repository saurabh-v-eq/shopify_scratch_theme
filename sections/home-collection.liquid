<script src="{{ 'facetFilter.js' | asset_url }}" defer></script>

<h2 class="collection-title">Collection Products</h2>

{% paginate collection.products by 4 %}
<div class="collection-wrapper">

  <!-- Sidebar Filters -->
  <aside class="facet-filters" aria-label="Collection Filters">
    <h2 class="facet-filter-title">
      {% render 'icons', icon: 'filter-icon' %}
      Filters
    </h2>

    <form id="FacetFiltersForm" class="facets-form" aria-live="polite">
      {% for filter in collection.filters %}
        <details class="facet">
          <summary class="facet-title" role="button" aria-expanded="false" tabindex="0">{{ filter.label }}</summary>

          <div class="facet-options">
            {% if filter.type == 'price_range' %}
              <div class="price-range">
                <label for="{{ filter.min_value.param_name }}">
                  Min Price
                  <input
                    id="{{ filter.min_value.param_name }}"
                    name="{{ filter.min_value.param_name }}"
                    type="number"
                    placeholder="0"
                    value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                    min="0"
                    aria-label="Minimum price filter"
                  >
                </label>

                <label for="{{ filter.max_value.param_name }}">
                  Max Price
                  <input
                    id="{{ filter.max_value.param_name }}"
                    name="{{ filter.max_value.param_name }}"
                    type="number"
                    placeholder="Any"
                    value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                    min="0"
                    aria-label="Maximum price filter"
                  >
                </label>
              </div>
            {% else %}
              {% for value in filter.values %}
                <label>
                  <input
                    type="checkbox"
                    name="{{ filter.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                    {% if value.count == 0 and value.active == false %}disabled{% endif %}
                    aria-checked="{{ value.active }}"
                  >
                  {{ value.label }} (<span aria-live="polite">{{ value.count }}</span>)
                </label>
              {% endfor %}
            {% endif %}
          </div>
        </details>
      {% endfor %}

      <noscript>
        <button type="submit" class="btn">Apply filters</button>
      </noscript>
    </form>
  </aside>

  <!-- Product Grid -->
  <section class="product-grid" id="product-grid" aria-label="Collection Products">
    {% for product in collection.products %}
      {% render 'product-card', product: product %}
    {% endfor %}

    {% if paginate.next %}
      <div class="load-more-wrapper">
        <button class="btn load-more-btn" id="load-more" data-next-url="{{ paginate.next.url }}" aria-label="Load more products">
          Load More
        </button>
      </div>
    {% endif %}
  </section>

</div>
{% endpaginate %}

{% style %}
  /* Layout */
  .collection-title {
    text-align: center;
    padding: 1.5rem 5rem;
    margin: 0;
  }

  .collection-wrapper {
    display: flex;
    align-items: flex-start;
    gap: 40px;
    padding: 2rem 5rem;
  }

  .facet-filters {
    width: 250px;
    min-width: 250px;
    max-width: 250px;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .facet-filter-title {
    margin-bottom: 15px;
    margin-top: 0px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .facets-form .facet {
    border-bottom: 1px solid #ccc;
    padding: 12px 0;
  }

  .facets-form .facet:first-child {
    border-top: 1px solid #ccc;
  }

  summary.facet-title {
    cursor: pointer;
    font-weight: 500;
    outline-offset: 2px;
  }

  .facet-options {
    margin-top: 8px;
    display: flex;
    flex-direction: column;
    padding-left: 16px;
  }

  .price-range label {
    display: block;
    margin-bottom: 8px;
    font-size: 0.9rem;
  }

  .price-range input[type="number"] {
    width: 100%;
    padding: 6px 8px;
    font-size: 1rem;
    border: 1px solid #ddd;
    border-radius: 4px;
  }

  /* Product Grid */
  .product-grid {
    flex-grow: 1;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 30px;
    min-width: 0;
  }

  /* Load More Button */
  .load-more-wrapper {
    grid-column: 1 / -1;
    display: flex;
    justify-content: center;
    margin-top: 20px;
  }

  .btn {
    height: 40px;
    width: 120px;
    background-color: #000;
    color: #fff;
    border: none;
    font-size: 15px;
    cursor: pointer;
    border-radius: 3px;
    transition: background-color 0.3s ease;
  }

  .btn:hover,
  .btn:focus {
    background-color: #444;
    outline: none;
  }

  /* Product Card */
  .product-card {
    border-radius: 5px;
    background-color: #fff;
    box-shadow: rgba(99, 99, 99, 0.15) 0px 2px 8px 0px;
    padding: 20px;
    display: flex;
    flex-direction: column;
  }

  .product-img img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease-in-out;
    margin-bottom: 10px;
  }

  .product-img img:hover,
  .product-img img:focus {
    transform: scale(1.03);
  }

  /* Responsive Styles */
  @media screen and (max-width: 768px) {
    .collection-wrapper {
      flex-direction: column;
      padding: 2rem 2rem;
    }

    .facet-filters {
      width: 100%;
      max-width: none;
      margin-bottom: 20px;
    }

    .product-grid {
      grid-template-columns: repeat(3, 1fr);
      padding: 0 1rem;
    }
  }

  @media screen and (max-width: 480px) {
    .product-grid {
      grid-template-columns: 1fr;
      padding: 0 1rem;
    }

    .product-card h4 {
      font-size: 14px;
      margin-bottom: 6px;
    }

    .product-card p {
      font-size: 13px;
    }

    .btn {
      width: 100%;
      max-width: 180px;
    }
  }
{% endstyle %}


{% schema %}
{
  "name": "t:sections.home-collection.name",
  "presets": [
    {
      "name": "t:sections.home-collection.presets.name"
    }
  ]
}
{% endschema %}
