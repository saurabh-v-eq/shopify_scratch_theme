<section class="collections-section">
  <div class="collections-container">
    {%- if section.settings.heading != blank -%}
      <h2>{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="collections-grid">
      {% for block in section.blocks %}
        {% assign collection = collections[block.settings.collection] %}
        {% if collection != blank %}
          <div class="collection-grid">
            <a href="{{ collection.url }}">
              <div class="collection-image-wrapper">
                {% if collection.image %}
                  <img src="{{ collection.image | image_url }}" alt="{{ collection.image.alt }}" height="" width="">
                {% endif %}
              </div>
              <h3>{{ collection.title }}</h3>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% style %}
  .collections-section {
    padding: 2rem 10rem;
    text-align: center;
  }

  .collections-container h2 {
    font-size: 2.5rem;
    text-transform: capitalize;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .collections-grid .collection-grid {
    border: 1px solid #ccc;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .collection-image-wrapper {
    height: 300px;
    width: 100%;
    overflow: hidden;
  }

  .collection-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.3s ease-in-out;
  }

  .collection-image-wrapper img:hover {
    transform: scale(1.03);
  }

  .collection-grid h3 {
    padding: 10px;
    font-size: 1.4rem;
  }

  @media (max-width: 1024px) {
    .collections-section{
        padding: 2rem 8rem;
    }

    .collections-container h2 {
      font-size: 2rem;
    }

    .collection-grid h3 {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 768px) {
    .collections-container h2 {
      font-size: 1.8rem;
    }

    .collection-grid h3 {
        font-size: 1rem;
    }

    .collections-grid {
        grid-template-columns: repeat(1, 1fr);
    }

    .collections-section{
        padding: 2rem 6rem;
    }
  }

  @media (max-width: 480px){
    .collections-section{
        padding: 2rem 2rem;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "t:sections.collections.name",
  "settings": [
    {
      "type": "text",
      "label": "Heading",
      "id": "heading",
      "default": "Shop Collections"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "label": "Collection",
          "id": "collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collections.presets.name"
    }
  ]
}
{% endschema %}
