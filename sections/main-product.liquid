{{ 'main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-message.js' | asset_url }}" defer></script>
<div class="product-detail">
  <div class="product-image">
    {% if product.featured_image != blank %}
      <img
        src="{{ product.featured_image | image_url: width: 700 }}"
        class="img-fluid"
        alt="{{ product.featured_image.alt }}"
        height=""
        width=""
      >
    {% endif %}
  </div>
  <div class="product-info">
    {% if product.title != blank %}
      <h1 class="product-title">{{ product.title | escape | upcase }}</h1>
    {% endif %}
    {% if product.description != blank %}
      <p class="product-des">{{ product.description }}</p>
    {% endif %}
    {% if product.price != blank %}
      <p class="product-price">{{ product.price | money }}</p>
    {% endif %}
    <div class="variant-info">
      {% if product.variants.size > 1 %}
        <form method="post" action="{{ routes.cart_add_url }}">
          {% if section.settings.variant_label != blank %}
            <p class="variant-select">{{ section.settings.variant_label }}</p>
          {% endif %}
          <ul class="variant-list">
            {% for variant in product.variants %}
              {% if variant.title != blank %}
                <li class="variant-item">
                  <input
                    type="radio"
                    name="id"
                    value="{{ variant.id }}"
                    id="variant-{{ variant.id }}"
                    {% if forloop.first %}
                      checked
                    {% endif %}
                  >
                  <label for="variant-{{ variant.id }}">{{ variant.title }}</label>
                </li>
              {% endif %}
            {% endfor %}
          </ul>
          <div class="product-custom-option">
            <div class="product-custom-option__checkbox">
              <label for="custom-checkbox" class="checkbox-label">
                <input type="checkbox" id="custom-checkbox" class="custom-checkbox">Add Message
              </label>
            </div>
            <div class="product-custom-option__input hidden" id="message">
              <label for="gift-message-input">Add your message</label>
              <input
                type="text"
                id="custom-input"
                name="properties[Message]"
                class="custom-input"
                Placeholder="Type your message..."
              >
            </div>
            <div id="message-error" class="message-error" style="color: red; font-size: 1.2rem; display: none;"></div>
          </div>
          {% if section.settings.btn_title != blank %}
            <button type="submit" class="cartButton">{{ section.settings.btn_title }}</button>
          {% endif %}
        </form>
      {% else %}
        <form method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {% if section.settings.btn_title != blank %}
            <button type="submit" class="cartButton">{{ section.settings.btn_title }}</button>
          {% endif %}
        </form>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "settings": [
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant selection label",
      "default": "Select Variants:"
    },
    {
      "type": "text",
      "label": "Cart Button Title",
      "id": "btn_title",
      "default": "Add to Cart"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-product.presets.name"
    }
  ]
}
{% endschema %}
