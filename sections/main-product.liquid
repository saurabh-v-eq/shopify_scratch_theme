{{ 'main-product.css' | asset_url | stylesheet_tag }}
<div class="product-detail">
  <div class="product-image">
    {% if product.featured_image != blank %}      
      <img
        src="{{ product.featured_image | image_url: width: 700 }}"
        class="img-fluid"
        alt="{{ product.featured_image.alt }}"
        height=""
        width=""
      >
    {% endif %}
  </div>
  <div class="product-info">
    {% if product.title != blank %}
      <h1 class="product-title">{{ product.title | escape | upcase }}</h1>
    {% endif %}
    {% if product.description != blank %}
      <p class="product-des">{{ product.description }}</p>
    {% endif %}
    {% if product.price != blank %}
      <p class="product-price">{{ product.price | money_with_currency }}</p>
    {% endif %}
    <div class="variant-info">
        {% if product.variants.size > 1 %}
          <form method="post" action="{{ routes.cart_add_url }}">
            <p class="variant-select">Select Variants:</p>
            <ul class="variant-list">
              {% for variant in product.variants %}
                {% if variant.title != blank %}
                  <li class="variant-item" data-value="{{ variant.id }}">{{ variant.title }}</li>
                {% endif %}
              {% endfor %}
            </ul>
            <button type="submit" class="cartButton">Add to Cart</button>
          </form>
        {% else %}
          <form method="post" action="{{ routes.cart_add_url }}">
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
            <button type="submit" class="cartButton">Add to Cart</button>
          </form>
        {% endif %}
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Product Detail",
  "settings": [],
  "presets": [
    {
      "name": "Product Detail"
    }
  ]
}
{% endschema %}
