{{ 'main-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'image-cropper.js' | asset_url }}" defer></script>
<script src="{{ 'custom-message.js' | asset_url }}" defer></script>
<div class="product-detail">
  <div class="product-image">
    {% if product.featured_image != blank %}
      <img
        src="{{ product.featured_image | image_url: width: 700 }}"
        class="img-fluid"
        alt="{{ product.featured_image.alt }}"
        height=""
        width=""
      >
    {% endif %}
  </div>
  <div class="product-info">
    {% if product.title != blank %}
      <h1 class="product-title">{{ product.title | escape | upcase }}</h1>
    {% endif %}

    {% if product.description != blank %}
      <p class="product-des">{{ product.description }}</p>
    {% endif %}

    {% if product.price != blank %}
      <p class="product-price">{{ product.price | money }}</p>
    {% endif %}

    <div class="variant-info">
        <form method="post" action="{{ routes.cart_add_url }}">
          {% if section.settings.variant_label != blank %}
            <p class="variant-select">{{ section.settings.variant_label }}</p>
          {% endif %}

          <!-- === Variants === -->
          <ul class="variant-list">
            {% for variant in product.variants %}
              <li class="variant-item">
                <input
                  type="radio"
                  name="id"
                  value="{{ variant.id }}"
                  id="variant-{{ variant.id }}"
                  {% if forloop.first %}
                    checked
                  {% endif %}
                >
                <label for="variant-{{ variant.id }}">{{ variant.title }}</label>
              </li>
            {% endfor %}
          </ul>

          <!-- === Custom options (message, upload) === -->
          <div class="product-custom-option">
            <div class="product-custom-option__checkbox">
              <label for="custom-checkbox" class="checkbox-label">
                <input type="checkbox" id="custom-checkbox" class="custom-checkbox">
                Add Message
              </label>
            </div>
            <div class="product-custom-option__input hidden" id="message">
              <label for="gift-message-input">Add your message</label>
              <input
                type="text"
                id="custom-input"
                name="properties[Message]"
                class="custom-input"
                placeholder="Type your message..."
              >
            </div>
            <div id="message-error" class="message-error" style="color:red; font-size:1.2rem; display:none;"></div>
          </div>

          <!-- === Image Upload with Cropper === -->
          <div class="image-upload-custom">
            <label for="custom-image-upload">Upload Image</label>
            <input type="file" name="properties[Uploaded Image]" id="custom-image-upload" accept="image/*">
          </div>
          <div id="cropper-modal" class="hidden">
          </div>
          <input type="hidden" name="properties[Cropped Image]" id="cropped-image-url">

          <!-- === ADD-ON PRODUCTS SECTION === -->
          {% if product.metafields.custom.add_on_products != blank %}
            <div class="addon-products">
              <h3 class="addon-title">People also bought</h3>
              <ul class="addon-list">
                {% for addon_product in product.metafields.custom.add_on_products.value %}
                  <li class="addon-item">
                    <div class="addon-info">
                      {% if addon_product.featured_image %}
                        <img
                          src="{{ addon_product.featured_image | image_url: width: 100 }}"
                          alt="{{ addon_product.title }}"
                          class="addon-image"
                          height=""
                          width=""
                        >
                      {% endif %}
                      <span class="addon-name">{{ addon_product.title }}</span>
                      <span class="addon-price">{{ addon_product.price | money }}</span>
                    </div>
                    <input
                      type="checkbox"
                      class="addon-checkbox"
                      data-variant-id="{{ addon_product.variants.first.id }}"
                    >
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <!-- === Add to Cart === -->
          {% if section.settings.btn_title != blank %}
            <button type="submit" class="cartButton">{{ section.settings.btn_title }}</button>
          {% endif %}
        </form>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "settings": [
    {
      "type": "text",
      "id": "variant_label",
      "label": "Variant selection label",
      "default": "Select Variants:"
    },
    {
      "type": "text",
      "label": "Cart Button Title",
      "id": "btn_title",
      "default": "Add to Cart"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-product.presets.name"
    }
  ]
}
{% endschema %}
