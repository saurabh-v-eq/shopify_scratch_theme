<html>
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {{ 'font-awesome.min.css' | asset_url | stylesheet_tag }}
    {{ 'cropper.min.css' | asset_url | stylesheet_tag }}

    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    {% style %}
      html, body {
        height: 100%;
        margin: 0;
        font-size: 12px;
      }

      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        font-size: 1.5rem;
        letter-spacing: 0.06rem;
      }

      main {
        flex: 1;
      }

      .no-scroll {
        overflow: hidden;
        height: 100vh;
      }

      a {
        text-decoration: none;
      }

      #searchresults {
        text-align: center;
      }
    {% endstyle %}

  </head>
  <body>
    {% if settings.cart_type == 'drawer' %}
      {% render 'cart-drawer' %}
    {% endif %}

    {% sections 'header-group' %}

    <main>
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'ajax-addToCart.js' | asset_url }}" defer></script>
    <script src="{{ 'image-popup.js' | asset_url }}" defer></script>
    
    <script src="{{ 'cropper.min.js' | asset_url }}" defer></script>
  </body>
</html>
