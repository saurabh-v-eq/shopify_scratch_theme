[
    {
        "name": "theme_info",
        "theme_name": "Bazario",
        "theme_version": "1.0.0",
        "theme_author": "Saurabh Varma",
        "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
        "theme_support_url": "https://support.shopify.com/"
    },
    {
        "name": "logo",
        "settings": [
            {
                "type": "image_picker",
                "label": "logo",
                "id": "logo"       
            },
            {
                "type": "range",
                "min": 50,
                "max": 300,
                "default":100,
                "step": 10,
                "unit": "px",
                "id": "logo_width",
                "label": "logo width"
            }
        ]
    },
    {
        "name": "Cart Settings",
        "settings": [
            {
                "type": "select",
                "id": "cart_type",
                "label": "Cart Type",
                "default": "drawer",
                "options": [
                    {
                        "value": "drawer",
                        "label": "Drawer"
                    },
                    {
                        "value": "page",
                        "label": "Page"
                    }
                ]
            }
        ]
    }
]
