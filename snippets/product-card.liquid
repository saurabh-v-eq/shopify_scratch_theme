<div class="product-card">
  <div class="product-img">
    <a href="{{ product.url }}">
      {% if product.featured_image != blank %}        
        <img
          src="{{ product.featured_image | image_url }}"
          alt="{{ product.featured_image.alt | escape }}"
          height=""
          width=""
        >
      {% endif %}
    </a>
  </div>

  {% if product.title != blank %}
    <h4>{{ product.title | capitalize }}</h4>
  {% endif %}
  {% if product.price != blank %}
    <p>{{ product.price | money_with_currency }}</p>
  {% endif %}

  <!-- Actions row -->
  <div class="product-actions">
    <form method="post" action="{{ routes.cart_add_url }}">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      <button type="submit" class="cartButton">Add to Cart</button>
    </form>

    <!-- Wishlist Icon -->
    <button 
      class="wishlist-btn" 
      data-product-handle="{{ product.handle }}" 
      aria-label="Add to Wishlist">
      <svg class="wishlist-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 
                  2 5.42 4.42 3 7.5 3c1.74 0 3.41 0.81 4.5 2.09 
                  C13.09 3.81 14.76 3 16.5 3 
                  19.58 3 22 5.42 22 8.5 
                  c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    </button>
  </div>
</div>

<style>
.product-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
}

.cartButton {
  background: #222;
  color: #fff;
  padding: 8px 14px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.25s ease;
}

.cartButton:hover {
  background: #444;
}

.wishlist-btn {
  background: none;
  border: 1px solid #ccc;
  cursor: pointer;
  padding: 6px;
  border-radius: 50%;
  transition: all 0.25s ease;
}

.wishlist-btn:hover {
  border-color: #e53935;
  background: #ffebee;
}

.wishlist-icon {
  width: 20px;
  height: 20px;
  fill: #999;
  transition: fill 0.25s ease;
}

.wishlist-btn.active {
  border-color: #e53935;
}

.wishlist-btn.active .wishlist-icon {
  fill: #e53935;
}

</style>

