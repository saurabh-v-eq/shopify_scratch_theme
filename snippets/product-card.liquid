<div class="product-card">
  <div class="product-img">
    <a href="{{ product.url }}">
      {% if product.featured_image != blank %}        
        <img
          src="{{ product.featured_image | image_url }}"
          alt="{{ product.featured_image.alt | escape }}"
          height=""
          width=""
        >
      {% endif %}
    </a>
  </div>

  {% if product.title != blank %}
    <h4>{{ product.title | capitalize }}</h4>
  {% endif %}

  {% if product.price != blank %}
    <p>{{ product.price | money_with_currency }}</p>
  {% endif %}

  <!-- Actions row -->
  <div class="product-actions">
    <form method="post" action="{{ routes.cart_add_url }}">
      <input type="hidden" name="id" value="{{ product.variants.first.id }}">
      <button type="submit" class="cartButton">Add to Cart</button>
    </form>

    <!-- Wishlist Icon -->
    <button 
      class="wishlist-btn" 
      data-product-handle="{{ product.handle }}" 
      aria-label="Add to Wishlist">
      {% render 'icons', icon: 'wishlist' %}
    </button>
  </div>
    <!-- Ratings Metafield -->
  {% if product.metafields.custom.rating != blank %}    
    <div class="rating-block">
      <div class="star-rating">
        <div class="star-outer"></div>
        <div class="star-inner stars-fill" data-rating="{{ product.metafields.custom.rating.value }}"></div>
      </div>
      <div>{{ product.metafields.custom.rating }}</div>
    </div>
  {% endif %}
</div>


<style>
.product-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 10px;
}

.cartButton {
  background: #222;
  color: #fff;
  padding: 8px 14px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  transition: background 0.25s ease;
}

.cartButton:hover {
  background: #444;
}

.wishlist-btn {
  background: none;
  border: 1px solid #ccc;
  cursor: pointer;
  padding: 6px;
  border-radius: 50%;
  transition: all 0.25s ease;
}

.wishlist-btn:hover {
  border-color: #e53935;
  background: #ffebee;
}

.wishlist-icon {
  width: 20px;
  height: 20px;
  fill: #999;
  transition: fill 0.25s ease;
}

.wishlist-btn.active {
  border-color: #e53935;
}

.wishlist-btn.active .wishlist-icon {
  fill: #e53935;
}

.rating-block{
  display: flex;
  align-items: center;
  gap: 5px;
  font-size: 1.4rem;
}

.star-rating {
  position: relative;
  display: inline-block;
  line-height: 1;
}

.star-outer {
  color: #ccc; /* grey for unfilled stars */
}

.star-inner { 
  color: #f8ce0b;  /* gold for filled stars */
  position: absolute;
  top: 0;
  left: 0;
  width: 0;
  white-space: nowrap;
  overflow: hidden;
}

.star-outer::before,
.star-inner::before {
  content: '★★★★★';
}

</style>
