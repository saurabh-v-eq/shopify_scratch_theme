{{ 'cart-drawer.css' | asset_url | stylesheet_tag }}
<div class="cart-drawer-overlay" id="cart-drawer-overlay"></div>
<div id="cart-drawer" class="cart-drawer">
  <div class="cart-drawer-content">
    <button class="cart-drawer-close" id="cart-drawer-close">x</button>

    <div id="cart-drawer-items">
      {% if cart.item_count > 0 %}
        <h2 class="heading">Your Cart ({{ cart.item_count }} items)</h2>
        <ul class="cart-items-list">
          {% for item in cart.items %}
            <li class="cart-item">
              <img
                src="{{ item.image | image_url }}"
                alt="{{ item.product.title }}"
                class="item-image"
                height=""
                width=""
              >
              <div class="cart-item-details">
                <p>{{ item.product.title }}</p>
                <P>{{ item.variant.title }}</P>
                <p>Qty: {{ item.quantity }}</p>
                <p>{{ item.final_line_price | money }}</p>
                {% for property in item.properties %}
                  <div class="line-item-property">
                    <dt>{{ property.first }}:</dt>
                    <dd>
                      {% if property.last contains '/uploads/' %}
                        <a href="{{ property.last }}" class="image-preview-link" data-image-url="{{ property.last }}" target="_blank">{{ property.last | split: '/' | last }}</a>
                      {% else %} 
                        {{ property.last }}
                      {% endif %}
                    </dd>
                  </div>
                {% endfor %}
              </div>
              <a href="{{ item.url_to_remove }}" class="remove-item-button" data-line="{{ forloop.index }}"
                ><i class="fa-solid fa-trash"></i
              ></a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="cart-empty-message">
          <p>Your cart is empty</p>
          <a href="{{ routes.collections_url }}" class="continue-shopping-button">Continue Shopping</a>
        </div>
      {% endif %}
    </div>

    {% if cart.item_count > 0 %}
      <div class="cart-drawer-footer">
        <p>
          <strong>Total:</strong> <span id="cart-drawer-total">{{ cart.total_price | money }}</span>
        </p>
        <a href="{{ routes.cart_url }}" class="view-cart-button">View Cart</a>
        <a href="/checkout" class="checkout-button">Checkout</a>
      </div>
    {% endif %}
  </div>
</div>
<div class="image-popup-modal hidden" id="image-popup-modal">
  <div class="image-popup-content">
    <button id="image-popup-close" class="image-popup-close">&times;</button> 
    <img src="{{ '' | asset_url }}" id="popup-image" class="popup-image" height="" width=""> 
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const cartDrawer = document.getElementById('cart-drawer');
    const cartOverlay = document.getElementById('cart-drawer-overlay');
    const cartOpenBtn = document.getElementById('cart-icon-button');
    const cartCloseBtn = document.getElementById('cart-drawer-close');

    cartOpenBtn.addEventListener('click', () => {
      cartDrawer.classList.add('open');
      cartOverlay.classList.add('active');
      document.body.classList.add('no-scroll');
    });

    cartCloseBtn.addEventListener('click', () => {
      cartDrawer.classList.remove('open');
      cartOverlay.classList.remove('active');
      document.body.classList.remove('no-scroll');
    });

    cartOverlay.addEventListener('click', () => {
      cartDrawer.classList.remove('open');
      cartOverlay.classList.remove('active');
      document.body.classList.remove('no-scroll');
    });
  });
</script>
